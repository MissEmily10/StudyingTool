# Скопируйте в .env и заполните.

# Вход в приложение (браузер спросит логин и пароль)
APP_USER=student
APP_PASSWORD=придумайте-длинный-пароль

# Имя, под которым бот заходит на вебинар (его увидит учитель)
BOT_NAME=Имя Фамилия

# Конспекты: ключ Claude API (https://platform.claude.com → API Keys)
ANTHROPIC_API_KEY=

# Распознавание речи: облачный Whisper API (OpenAI или совместимый сервис)
TRANSCRIBE_PROVIDER=api
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1
# Вариант для Groq: TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1 и TRANSCRIBE_MODEL=whisper-large-v3
# Без облака: TRANSCRIBE_PROVIDER=local и собрать образ с LOCAL_WHISPER=1 (медленнее, нужно 4+ ГБ памяти)

# Запись: максимум минут и через сколько минут тишины считать эфир законченным
MAX_RECORD_MINUTES=120
SILENCE_STOP_MINUTES=10

TZ=Europe/Moscow
