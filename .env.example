# Скопируйте в .env и заполните.

# Вход в приложение (браузер спросит логин и пароль)
APP_USER=student
APP_PASSWORD=придумайте-длинный-пароль

# Имя, под которым бот заходит на вебинар (его увидит учитель)
BOT_NAME=Имя Фамилия

# Конспекты: ключ Claude API (https://platform.claude.com → API Keys) — единственный платный ключ
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Для самых подробных конспектов (примерно вдвое дороже): CLAUDE_MODEL=claude-opus-5-5

# Распознавание речи прямо на сервере — бесплатно, ключ не нужен.
# Урок распознаётся примерно столько же, сколько длился (на 4 ядрах).
TRANSCRIBE_PROVIDER=local

# Если захочется быстрее — облачный Whisper API (платно):
# TRANSCRIBE_PROVIDER=api
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MODEL=whisper-1

# Запись: максимум минут и через сколько минут тишины считать эфир законченным
MAX_RECORD_MINUTES=120
SILENCE_STOP_MINUTES=10

TZ=Europe/Moscow
