# Скопируйте в .env и заполните.

# Вход в приложение (браузер спросит логин и пароль)
APP_USER=student
APP_PASSWORD=придумайте-длинный-пароль

# Имя, под которым бот заходит на вебинар (его увидит учитель)
BOT_NAME=Имя Фамилия

# Конспекты пишет Claude в обычной подписке (без API).
# Сервер кладёт расшифровки уроков в репозиторий GitHub (папка lessons/) и забирает оттуда готовые konspekt.md.
# Нужен токен GitHub с правом записи в этот репозиторий:
# github.com → Settings → Developer settings → Fine-grained tokens → Generate new token →
#   Repository access: Only select repositories → StudyingTool; Permissions → Contents: Read and write.
SUMMARY_MODE=session
GITHUB_TOKEN=
GIT_REPO=github.com/MissEmily10/StudyingTool
GIT_BRANCH=master

# Если когда-нибудь появится доступ к Claude API — конспекты сможет писать сам сервер:
# SUMMARY_MODE=api
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Распознавание речи прямо на сервере — бесплатно, ключ не нужен.
# Урок распознаётся примерно столько же, сколько длился (на 4 ядрах).
TRANSCRIBE_PROVIDER=local

# Если захочется быстрее — облачный Whisper API (платно):
# TRANSCRIBE_PROVIDER=api
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MODEL=whisper-1

# Запись: максимум минут и через сколько минут тишины считать эфир законченным
MAX_RECORD_MINUTES=120
SILENCE_STOP_MINUTES=10

TZ=Europe/Moscow
